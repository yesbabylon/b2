{
  "schema": 1,
  "image": {
    "name": "b2-wordpress",
    "environment_version": "7.1",
    "description": "B2 runtime environment for WordPress",
    "maintainer": "Cedric Francoys <cedricfrancoys@gmail.com>",
    "license": "Apache-2.0"
  },
  "base_image": "wordpress:7.1.1-php8.5",
  "components": {
    "wordpress": "7.1.1",
    "php": "8.5",
    "apache": "2.4"
  },
  "php_extensions": [
    "mysqli",
    "pdo",
    "pdo_mysql"
  ],
  "apache_modules": [
    "expires",
    "rewrite"
  ],
  "paths": {
    "application": "/var/www/html",
    "wordpress_source": "/usr/src/wordpress"
  },
  "runtime": {
    "entrypoint": [
      "docker-entrypoint.sh"
    ],
    "command": [
      "apache2-foreground"
    ],
    "working_directory": "/var/www/html",
    "application_volume": "/var/www/html"
  },
  "build": {
    "arguments": [
      "apache_uid",
      "apache_gid"
    ]
  },
  "compatibility": {
    "architecture": [
      "linux/amd64"
    ],
    "application": "WordPress",
    "application_version": "7.1.1"
  }
}
