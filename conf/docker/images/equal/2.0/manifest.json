{
  "schema": 1,
  "image": {
    "name": "b2-equal",
    "environment_version": "2.0",
    "description": "B2 Runtime environnement for eQual",
    "maintainer": "Cedric Francoys <cedricfrancoys@gmail.com>",
    "license": "Apache-2.0"
  },
  "components": {
    "php": "8.3",
    "apache": "2.4",
    "msodbcsql": "17",
    "sqlsrv": "5",
    "pdo_sqlsrv": "5"
  },
  "php_extensions": [
    "dom",
    "gd",
    "intl",
    "mbstring",
    "mysqli",
    "opcache",
    "pdo_sqlsrv",
    "sqlsrv",
    "zip"
  ],
  "apache_modules": [
    "expires",
    "rewrite"
  ],
  "paths": {
    "application": "/var/www/html",
    "dynamic_binaries": "/opt/bin"
  },
  "runtime": {
    "entrypoint": null,
    "command": [
      "apache2-foreground"
    ],
    "working_directory": "/var/www/html",
    "application_volume": "/var/www/html"
  },
  "compatibility": {
    "architecture": [
      "linux/amd64"
    ],
    "application": "eQual",
    "application_version": "2.0"
  }
}